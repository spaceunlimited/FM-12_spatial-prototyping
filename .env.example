# Copy this file to `.env` and fill in what you have. `.env` is never committed.
# `npm run dev` creates `.env` from this file if it is missing.

# --- AI provider (optional) ---
# Leave the keys empty to run in fake mode only. Everything still works.
# gemini (default): get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=

# openai-compatible: OpenAI, Mistral, or a local Ollama (OPENAI_BASE_URL=http://localhost:11434/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Rarely needed ---
# Requests per minute per device through the proxy. 0 = no limit.
RATE_LIMIT_RPM=0
# Dev server port (HTTPS) and the plain-HTTP port that serves the certificate for download.
DEV_PORT=5173
CERT_HTTP_PORT=5174

# --- Voice clips (optional) ---
# tools/voice.mjs renders spoken lines to public/voice/*.mp3 with ElevenLabs. Paste your key here;
# the voice id is optional: without it the tool uses a premade voice (sarah); george, jessica, daniel work too.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
