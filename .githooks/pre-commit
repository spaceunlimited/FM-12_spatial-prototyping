#!/bin/sh
# Blocks commits that would leak a key: a staged .env file or a key-shaped string.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -qx '.env'; then
  echo "✗ .env is staged. It holds your API key and must never be committed."
  echo "  Fix: git restore --staged .env"
  exit 1
fi
if echo "$staged" | grep -q '^\.env\.' && ! echo "$staged" | grep -qx '.env.example'; then
  echo "✗ A .env.* file is staged. Only .env.example may be committed."
  exit 1
fi
added=$(git diff --cached -U0 | grep -E '^\+' | grep -v '^+++')
if echo "$added" | grep -Eq 'AIza[0-9A-Za-z_-]{35}'; then
  echo "✗ A string that looks like a Gemini API key is in the staged changes. Keep keys in .env."
  exit 1
fi
if echo "$added" | grep -Eq 'sk-[A-Za-z0-9_-]{32,}'; then
  echo "✗ A string that looks like an OpenAI-style API key is in the staged changes. Keep keys in .env."
  exit 1
fi
if echo "$added" | grep -Eq 'sk_[a-f0-9]{40,}'; then
  echo "✗ A string that looks like an ElevenLabs API key is in the staged changes. Keep keys in .env."
  exit 1
fi
exit 0
