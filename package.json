{
  "name": "xr-sandbox",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "description": "WebXR sandbox for quick mixed-reality demos with AI components, on phones and headsets",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/capabilities.mjs --check && vite build",
    "preview": "vite preview --host",
    "check": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.json --noEmit",
    "screenshot": "node scripts/smoke.mjs screenshot",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "capabilities": "node scripts/capabilities.mjs",
    "check-standalone": "node scripts/check-standalone.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "show-url": "node scripts/show-url.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@pmndrs/pointer-events": "6.6.31",
    "@pmndrs/uikit": "1.0.76",
    "hono": "4.13.12",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@iwer/devui": "2.5.0",
    "@iwer/sem": "2.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/three": "0.186.0",
    "iwer": "2.5.0",
    "qrcode-terminal": "0.12.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
